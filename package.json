{
  "name": "golden-dragon-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "main": "electron/main.cjs",
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "com.hezhongxing.automation",
    "productName": "合众兴",
    "artifactName": "合众兴完整安装包-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/index.html", "dist/assets/**/*", "electron/**/*", "package.json"],
    "extraResources": [{
      "from": "vendor/ShadowBot-6.2.23-x64.exe",
      "to": "vendor/ShadowBot-6.2.23-x64.exe"
    }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "preCompressedFileExtensions": [".exe"],
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
